# .env.example for apps/web
#
# Copy to .env.local for local development.
# For production, set these in the Vercel dashboard (not in this file).

# ── API URL ────────────────────────────────────────────────────────────────
# Local development (API running on local port 3001):
NEXT_PUBLIC_API_URL=http://localhost:3001

# Production (Render-hosted API) — set this in Vercel dashboard env vars:
# NEXT_PUBLIC_API_URL=https://heisenbug-api.onrender.com

# ── Clerk Authentication ────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your application → API Keys
# For production, use the LIVE keys (pk_live_*, sk_live_*)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c3RhYmxlLWZhd24tMjc1LmNsZXJrLmFjY291bnRzLmRldiQ

# NEVER expose CLERK_SECRET_KEY via NEXT_PUBLIC_* — set only in Vercel server-side env vars
CLERK_SECRET_KEY=sk_test_...
