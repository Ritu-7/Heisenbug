{
  "name": "heisenbug",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "docker:build": "node infra/build-images.js",
    "test:e2e": "node test-e2e-api.js",
    "test:e2e:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bcryptjs@2.4.3": true,
    "dotenv@16.6.1": true,
    "jsonwebtoken@9.0.3": true
  }
}
